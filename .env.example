# App
RAG_ENVIRONMENT=development
RAG_DEBUG=false
RAG_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RAG_MAX_UPLOAD_MB=25

# Embeddings through local Ollama (recommended)
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=embeddinggemma

# Optional in-process alternative (requires backend[local-embeddings])
# RAG_EMBEDDING_PROVIDER=sentence-transformers
# RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
# RAG_EMBEDDING_DEVICE=cuda

# Vector storage: qdrant or memory
RAG_VECTOR_BACKEND=qdrant
RAG_QDRANT_COLLECTION=daaneshyar_chunks_v1
# Leave blank for embedded local Qdrant when running without Docker
RAG_QDRANT_URL=
RAG_QDRANT_API_KEY=

# Local LLM
RAG_LLM_PROVIDER=ollama
RAG_OLLAMA_BASE_URL=http://localhost:11434
RAG_OLLAMA_MODEL=qwen3:4b
RAG_OLLAMA_KEEP_ALIVE=10m
RAG_LLM_TEMPERATURE=0.15
RAG_LLM_CONTEXT_WINDOW=8192

# Optional OpenAI-compatible provider
# RAG_LLM_PROVIDER=openai-compatible
# RAG_OPENAI_BASE_URL=https://api.openai.com/v1
# RAG_OPENAI_API_KEY=
# RAG_OPENAI_MODEL=gpt-4.1-mini

# Retrieval
RAG_RETRIEVAL_TOP_K=6
RAG_DENSE_WEIGHT=0.65
RAG_LEXICAL_WEIGHT=0.35

# Zero-download deterministic mode for tests and UI previews
RAG_DEMO_MODE=false
